<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>YFrame.upload.cos</AssemblyName>
    <RootNamespace>YFrame.upload.cos</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与主框架共用云白主题和控件样式，保证上传器 UI 一致 -->
    <Page Include="..\YFrame\Common\Themes\CloudWhiteTheme.xaml"
          Link="Themes\CloudWhiteTheme.xaml" />
    <Page Include="..\YFrame\Common\Themes\ControlStyles.xaml"
          Link="Themes\ControlStyles.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- 腾讯云 COS 官方 .NET SDK，仅用于本上传 Demo -->
    <PackageReference Include="Tencent.QCloud.Cos.Sdk" Version="5.4.51" />
  </ItemGroup>

</Project>
