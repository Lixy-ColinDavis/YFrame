<Window x:Class="YFrame.upload.cos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YFrame COS 上传"
        Height="620" Width="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFontFamily}">

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="COS" Foreground="White" FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="YFrame COS 上传"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="仅测试 YF_Version.json"
                               FontSize="10.5"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✕"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        Margin="0,0,6,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,4,18,12">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="YF_Version.json" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Width="112"/>
                                <TextBox x:Name="FilePathBox" Grid.Column="1"
                                         IsHitTestVisible="False"
                                         Focusable="False"
                                         Background="{DynamicResource PanelAltBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         Margin="0,0,8,0"
                                         ToolTip="选择要上传的 YF_Version.json"/>
                                <Button Grid.Column="2" Content="浏览..."
                                        Click="BrowseButton_Click"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bucket" Style="{StaticResource MutedText}"
                                           Width="112" VerticalAlignment="Center"/>
                                <TextBox x:Name="BucketBox" Grid.Column="1"
                                         Text="yfcos-1256976024"
                                         Margin="0,0,12,0"/>
                                <TextBlock Text="Region" Grid.Column="2"
                                           Style="{StaticResource MutedText}"
                                           Width="54" VerticalAlignment="Center"/>
                                <TextBox x:Name="RegionBox" Grid.Column="3"
                                         Text="ap-beijing"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="环境" Style="{StaticResource MutedText}"
                                           Width="112" VerticalAlignment="Center"/>
                                <ComboBox x:Name="EnvironmentBox" Grid.Column="1"
                                          SelectedIndex="0"
                                          SelectionChanged="EnvironmentBox_SelectionChanged"
                                          Margin="0,0,12,0">
                                    <ComboBoxItem Content="uat"/>
                                    <ComboBoxItem Content="pdt"/>
                                </ComboBox>
                                <TextBlock Text="对象键" Grid.Column="2"
                                           Style="{StaticResource MutedText}"
                                           Width="54" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ObjectKeyText" Grid.Column="3"
                                           Text="YFrame/update/uat/YF_Version.json"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SecretId" Style="{StaticResource MutedText}"
                                           Width="112" VerticalAlignment="Center"/>
                                <TextBox x:Name="SecretIdBox" Grid.Column="1"
                                         Margin="0,0,12,0"/>
                                <TextBlock Text="SecretKey" Grid.Column="2"
                                           Style="{StaticResource MutedText}"
                                           Width="54" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="SecretKeyBox" Grid.Column="3"
                                             Height="34"
                                             Padding="9,0"
                                             Background="{DynamicResource PanelAltBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             Foreground="{DynamicResource TextBrush}"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Margin="0,12,0,0"
                                       Text="仅上传单独文件，不执行打包、签名或清单校验；密钥只保存在当前进程内存中。"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"/>

                            <Grid Grid.Row="5" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="UploadProgress"
                                             Height="8"
                                             Minimum="0" Maximum="100"
                                             Value="0"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0"/>
                                <Button x:Name="UploadButton" Grid.Column="1"
                                        Content="开始上传"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="110"
                                        Click="UploadButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="上传日志" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="LogBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="130"
                                     Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,0">
                <Grid>
                    <TextBlock x:Name="StatusText"
                               Text="等待上传"
                               FontSize="10.5"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Tencent COS · Simple Upload"
                               FontSize="10"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
