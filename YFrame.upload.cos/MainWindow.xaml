<Window x:Class="YFrame.upload.cos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YFrame COS 上传"
        Height="720" Width="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFontFamily}">

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="COS" Foreground="White" FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="YFrame COS 上传"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="UAT / PDT 发布文件"
                               FontSize="10.5"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✕"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        Margin="0,0,6,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,4,18,12">
                <StackPanel>
                    <!-- 配置 -->
                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="上传配置" Style="{StaticResource SectionTitle}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pack output" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding PackOutputRoot, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding PackOutputRoot}"
                                         Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="浏览" Margin="0,0,6,0"
                                            Command="{Binding BrowsePackCommand}"/>
                                    <Button Content="刷新" Command="{Binding RefreshCommand}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SecretKey.csv" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SecretKeyFile, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding SecretKeyFile}"
                                         Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="浏览" Margin="0,0,6,0"
                                            Command="{Binding BrowseSecretCommand}"/>
                                    <Button Content="重读" Command="{Binding ReloadCredentialCommand}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bucket" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Margin="0,0,12,0"
                                         Text="{Binding Bucket, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Region" Grid.Column="2"
                                           Style="{StaticResource MutedText}"
                                           Width="50" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="3"
                                         Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="环境" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Margin="0,0,12,0"
                                          ItemsSource="{Binding Environments}"
                                          SelectedItem="{Binding Environment, Mode=TwoWay}"/>
                                <TextBlock Text="对象前缀" Grid.Column="2"
                                           Style="{StaticResource MutedText}"
                                           Width="60" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ObjectPrefix}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource PanelAltBrush}"
                                    CornerRadius="8" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                                             Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SecretIdHint}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource SubtleTextBrush}"/>
                                    <TextBlock Text="  ·  密钥只在内存中使用，不写入配置"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource SubtleTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 文件列表 -->
                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="待上传文件" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding FileCountText}"
                                           Style="{StaticResource MonoText}"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedPackDirectory}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10"
                                       Margin="0,5,0,8"
                                       TextTrimming="CharacterEllipsis"/>

                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding ObjectKey}"
                                                               FontFamily="{DynamicResource MonoFontFamily}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource SubtleTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SizeText}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Status}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 上传 -->
                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Status}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <ProgressBar Height="8"
                                             Margin="0,9,18,0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="上传四个文件"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="130"
                                    Command="{Binding UploadCommand}"/>
                        </Grid>
                    </Border>

                    <!-- 日志 -->
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="上传日志" Style="{StaticResource SectionTitle}"/>
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="110"
                                     Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,0">
                <Grid>
                    <TextBlock Text="上传顺序：current.zip → increment.zip → YF_Version.json.sig → YF_Version.json"
                               FontSize="10"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Tencent COS · Simple Upload"
                               FontSize="10"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
