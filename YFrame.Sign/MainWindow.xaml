<Window x:Class="YFrame.Sign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YFrame Sign"
        Width="800" Height="540"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        Icon="Assets/Logo.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sign 卡片沿用 Pack/主框架的 CardBorder 圆角与描边 -->
        <Style x:Key="SignCard" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PathTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,3"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="YF" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="YFrame Sign" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="更新清单签名工具" FontSize="10"
                                       Foreground="{DynamicResource SubtleTextBrush}"/>
                        </StackPanel>
                        <Border Style="{StaticResource BadgeBorder}" Margin="12,0,0,0">
                            <TextBlock Text="ECDSA P-256" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="—"
                                ToolTip="最小化" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="✕"
                                ToolTip="关闭" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1" Margin="16,12,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部说明 -->
                <Border Grid.Row="0" Style="{StaticResource SignCard}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="对 YF_Version.json 进行签名"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="签名对象是清单原始字节，输出 YF_Version.json.sig"
                                       FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource BadgeBorder}" Margin="0,0,6,0">
                                <TextBlock Text="SHA-256" FontSize="9"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}">
                                <TextBlock Text="离线私钥" FontSize="9"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 路径配置 -->
                <Border Grid.Row="2" Style="{StaticResource SignCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="父目录" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BaseDirectoryTextBox" Grid.Column="1"
                                     Style="{StaticResource PathTextBox}"
                                     TextChanged="PathInput_TextChanged"
                                     ToolTip="待签清单所在目录，默认取 Pack 最新输出目录"/>
                            <Button Grid.Column="2" Content="选择" Margin="6,0,0,0"
                                    Click="BrowseBaseDirectory_Click"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相对文件" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RelativeManifestTextBox" Grid.Column="1"
                                     Style="{StaticResource PathTextBox}"
                                     TextChanged="PathInput_TextChanged"
                                     ToolTip="相对父目录的清单路径，例如 YF_Version.json"/>
                            <Button Grid.Column="2" Content="选择" Margin="6,0,0,0"
                                    Click="BrowseManifest_Click"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="私钥" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="KeyPathTextBox" Grid.Column="1"
                                     Style="{StaticResource PathTextBox}"
                                     TextChanged="PathInput_TextChanged"
                                     ToolTip="ECDSA 私钥 PEM 文件"/>
                            <Button Grid.Column="2" Content="选择" Margin="6,0,0,0"
                                    Click="BrowseKey_Click"/>
                        </Grid>

                        <TextBlock x:Name="ActualPathText" Grid.Row="5"
                                   FontSize="10" Foreground="{DynamicResource SubtleTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="76,7,0,0"/>
                    </Grid>
                </Border>

                <!-- 操作区 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                 Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusText" Text="就绪"
                                   FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="生成临时密钥" Margin="0,0,8,0"
                                Click="GenerateKey_Click"/>
                        <Button Content="打开输出" Margin="0,0,8,0"
                                Click="OpenOutput_Click"/>
                        <Button Content="开始签名" Style="{StaticResource PrimaryButton}"
                                Click="Sign_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 日志 -->
                <Border Grid.Row="6" Style="{StaticResource SignCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="签名日志" Style="{StaticResource SectionTitle}"/>
                            <Button Content="清空" Style="{StaticResource IconButton}"
                                    Width="44" HorizontalAlignment="Right"
                                    Click="ClearLog_Click"/>
                        </Grid>

                        <TextBox x:Name="LogTextBox" Grid.Row="2"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 FontFamily="{DynamicResource MonoFontFamily}"
                                 FontSize="10"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextChanged="LogTextBox_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="密钥仅保存在本地；请勿把生产私钥提交到仓库或上传 COS"
                               FontSize="9.5" Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConfigPathText" FontSize="9"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
