<Window x:Class="YFrame.Pack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YFrame Pack"
        Width="1120" Height="760"
        MinWidth="980" MinHeight="680"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        Icon="Assets/Logo.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Pack 卡片：沿用主框架 CardBorder 的圆角、描边和层级 -->
        <Style x:Key="PackCard" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PathTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>

        <Style x:Key="UrlTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
            <Setter Property="Padding" Value="9,3"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9"
                                Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="YF" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="YFrame Pack" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="版本增量包构建工具" FontSize="10"
                                       Foreground="{DynamicResource SubtleTextBrush}"/>
                        </StackPanel>
                        <Border Style="{StaticResource BadgeBorder}" Margin="14,0,0,0">
                            <TextBlock Text="BUILD TOOL" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="—"
                                ToolTip="最小化" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="✕"
                                ToolTip="关闭" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1" Margin="24,18,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题与主操作 -->
                <Border Grid.Row="0" Style="{StaticResource PackCard}" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="版本增量包构建" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="选择两个 YF-*.*.*.zip，自动比较文件、生成增量包和 YF_Version.json"
                                       FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}"
                                       Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,0">
                                    <TextBlock Text="ZIP 差异比较" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,0">
                                    <TextBlock Text="MD5 校验" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}">
                                    <TextBlock Text="配置自动保存" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Width="110" Height="4" Margin="0,0,14,0"
                                         IsIndeterminate="{Binding IsBusy}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Content="打开输出目录"
                                    Command="{Binding OpenOutputCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="开始构建"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BuildCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 左右两栏 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：输入、地址、日志 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 输入版本包 -->
                        <Border Grid.Row="0" Style="{StaticResource PackCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock Text="输入版本包" Style="{StaticResource SectionTitle}"/>
                                    <Button Content="⇅ 交换" Style="{StaticResource IconButton}"
                                            Width="58" HorizontalAlignment="Right"
                                            Command="{Binding SwapCommand}"
                                            ToolTip="交换新旧版本"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="旧版本包" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource PathTextBox}"
                                             Text="{Binding PreviousZipPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding PreviousZipPath}"/>
                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorder}" Margin="8,0">
                                        <TextBlock Text="{Binding PreviousVersionText}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Button Grid.Column="3" Content="浏览"
                                            Command="{Binding BrowsePreviousCommand}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="新版本包" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource PathTextBox}"
                                             Text="{Binding CurrentZipPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding CurrentZipPath}"/>
                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorder}" Margin="8,0">
                                        <TextBlock Text="{Binding CurrentVersionText}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Button Grid.Column="3" Content="浏览"
                                            Command="{Binding BrowseCurrentCommand}"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="输出目录" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource PathTextBox}"
                                             Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="每次构建会在此目录下创建带时间戳的子目录，例如 20261117-153000"/>
                                    <Button Grid.Column="2" Content="选择"
                                            Command="{Binding BrowseOutputCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 发布地址 -->
                        <Border Grid.Row="2" Style="{StaticResource PackCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="9"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock Text="发布地址" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="地址会写入 YF_Version.json" Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="current" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource UrlTextBox}"
                                             Text="{Binding CurrentUrl, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding CurrentUrl}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="increment" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource UrlTextBox}"
                                             Text="{Binding IncrementUrl, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding IncrementUrl}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 构建日志 -->
                        <Border Grid.Row="4" Style="{StaticResource PackCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock Text="构建日志" Style="{StaticResource SectionTitle}"/>
                                    <Button Content="清空" Style="{StaticResource IconButton}"
                                            Width="44" HorizontalAlignment="Right"
                                            Command="{Binding ClearLogCommand}"/>
                                </Grid>

                                <TextBox x:Name="LogTextBox" Grid.Row="2"
                                         Text="{Binding LogText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         FontFamily="{DynamicResource MonoFontFamily}"
                                         FontSize="10.5"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextChanged="LogTextBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 右侧：概览和说明 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PackCard}">
                            <StackPanel>
                                <TextBlock Text="差异概览" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding VersionTransition}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="旧版本  →  新版本" Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0"/>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AddedCount}" Style="{StaticResource MetricValue}"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="新增" Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding ChangedCount}" Style="{StaticResource MetricValue}"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="修改" Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding RemovedCount}" Style="{StaticResource MetricValue}"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="删除" Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                                <TextBlock Text="输出文件" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource BadgeBorder}" Margin="0,0,0,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ZIP" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding IncrementFileName}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BadgeBorder}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="JSON" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding ManifestFileName}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Button Content="打开输出目录" Command="{Binding OpenOutputCommand}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PackCard}">
                            <StackPanel>
                                <TextBlock Text="构建规则" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="• 只比较文件内容，路径忽略大小写"
                                           Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                                <TextBlock Text="• 增量包只包含新增和修改文件"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                                <TextBlock Text="• 删除的文件写入 removed 数组"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                                <TextBlock Text="• current / pervious 均记录 size 和 MD5"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                                <TextBlock Text="• 配置保存在 exe 同目录的 YFrame.Pack.config.json"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                 Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OutputDirectory}" FontSize="10"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
