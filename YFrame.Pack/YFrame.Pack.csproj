<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用主框架主题和控件样式，避免 Pack 工具出现另一套视觉 -->
    <Resource Include="..\YFrame\Common\Themes\CloudWhiteTheme.xaml" Link="Themes\CloudWhiteTheme.xaml" />
    <Resource Include="..\YFrame\Common\Themes\ControlStyles.xaml" Link="Themes\ControlStyles.xaml" />
    <Resource Include="..\YFrame\Common\Images\Logo.png" Link="Assets\Logo.png" />
    <!-- 更新地址唯一默认来源，与 YFrame 共用一份代码 -->
    <Compile Include="..\YF_Manager\Common\UpdateDefaults.cs" Link="Common\UpdateDefaults.cs" />
    <!-- SHA-256 计算唯一实现，与 YFrame/YF_Manager 共用一份代码 -->
    <Compile Include="..\YF_Manager\Common\Tools\YF_Sha256Hasher.cs" Link="Common\Tools\YF_Sha256Hasher.cs" />
  </ItemGroup>

</Project>
