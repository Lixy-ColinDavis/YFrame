<UserControl x:Class="YFrame.Installer.Views.ComponentSelectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YFrame.Installer.Controls"
             xmlns:models="clr-namespace:YFrame.Installer.Models"
             Height="450" Width="700">

    <Grid>
        <controls:ParticleBackground ParticleCount="30">
            <controls:ParticleBackground.ParticleColor>
                <SolidColorBrush Color="#6BCB77"/>
            </controls:ParticleBackground.ParticleColor>
        </controls:ParticleBackground>

        <StackPanel Margin="40,30,40,0">
            <TextBlock Text="选择要安装的组件" FontSize="22" FontWeight="Bold"
                       Foreground="#E6EDF3" Margin="0,0,0,5"/>
            <TextBlock Text="勾选您需要的插件，未勾选的插件将不会被安装"
                       FontSize="13" Foreground="#8B949E" Margin="0,0,0,20"/>

            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PluginListControl" ItemsSource="{Binding Plugins}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PluginItem}">
                            <Border Background="#161B22" CornerRadius="8"
                                    Margin="0,4" Padding="14,12"
                                    BorderBrush="#30363D" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding IsRequired, Converter={StaticResource InverseBoolConverter}}"
                                              Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3">
                                            <Run Text="{Binding DisplayName}"/>
                                            <Run Text=" - " Foreground="#6E7681"/>
                                            <Run Text="{Binding SizeDisplay}" Foreground="#6E7681" FontSize="12"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8B949E"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="3"
                                            Background="#1F3A3F" Padding="6,2"
                                            Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibilityConverter}}"
                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="必选" FontSize="11" Foreground="#58A6FF"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding TotalSizeText}" FontSize="13" Foreground="#8B949E"
                       HorizontalAlignment="Right" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
