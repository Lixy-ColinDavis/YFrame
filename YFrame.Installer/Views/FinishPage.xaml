<UserControl x:Class="YFrame.Installer.Views.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YFrame.Installer.Controls"
             Height="450" Width="700">

    <Grid>
        <controls:ParticleBackground x:Name="ConfettiParticles" ParticleCount="120"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="80" Height="80" CornerRadius="40"
                    Background="#1F3A3F" BorderBrush="#3FB950" BorderThickness="3"
                    HorizontalAlignment="Center" Margin="0,0,0,20"
                    x:Name="CheckBorder" Opacity="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                </Border.RenderTransform>
                <TextBlock Text="&#x2713;" FontSize="40" FontWeight="Bold"
                           Foreground="#3FB950"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TitleText" Text="安装完成！"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#E6EDF3" HorizontalAlignment="Center"
                       Opacity="1" Margin="0,0,0,8"/>

            <TextBlock Text="YFrame 工具集已成功安装到您的计算机"
                       FontSize="14" Foreground="#8B949E"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Border Background="#161B22" CornerRadius="8"
                    Padding="16,10" BorderBrush="#30363D" BorderThickness="1"
                    HorizontalAlignment="Center">
                <TextBlock Text="您可以从桌面快捷方式或开始菜单启动 YFrame"
                           FontSize="12" Foreground="#8B949E"
                           HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
