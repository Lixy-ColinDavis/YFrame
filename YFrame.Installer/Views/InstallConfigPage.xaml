<UserControl x:Class="YFrame.Installer.Views.InstallConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YFrame.Installer.Controls"
             Height="450" Width="700">

    <Grid>
        <controls:ParticleBackground ParticleCount="30">
            <controls:ParticleBackground.ParticleColor>
                <SolidColorBrush Color="#FFD93D"/>
            </controls:ParticleBackground.ParticleColor>
        </controls:ParticleBackground>

        <StackPanel Margin="40,30,40,0">
            <TextBlock Text="安装配置" FontSize="22" FontWeight="Bold"
                       Foreground="#E6EDF3" Margin="0,0,0,20"/>

            <Border Background="#161B22" CornerRadius="8" Padding="16,14"
                    BorderBrush="#30363D" BorderThickness="1" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="安装路径" FontSize="14" FontWeight="SemiBold"
                               Foreground="#E6EDF3" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathTextBox" Grid.Column="0"
                                 Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0D1117" Foreground="#E6EDF3"
                                 BorderBrush="#30363D" BorderThickness="1"
                                 Padding="10,8" FontSize="13"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="BrowseButton" Grid.Column="1"
                                Content="浏览..." Width="70" Height="34"
                                Margin="8,0,0,0"
                                Background="#21262D" Foreground="#E6EDF3"
                                BorderBrush="#30363D" BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Name="border">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#30363D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="PathValidationText" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#161B22" CornerRadius="8" Padding="16,14"
                    BorderBrush="#30363D" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="快捷方式" FontSize="14" FontWeight="SemiBold"
                               Foreground="#E6EDF3" Margin="0,0,0,8"/>
                    <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式"
                              IsChecked="{Binding CreateDesktopShortcut}"
                              Foreground="#C9D1D9" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StartMenuCheck" Content="添加到开始菜单"
                              IsChecked="{Binding AddToStartMenu}"
                              Foreground="#C9D1D9" FontSize="13"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DiskSpaceText}"
                       FontSize="12" Foreground="#6E7681"
                       HorizontalAlignment="Right" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
