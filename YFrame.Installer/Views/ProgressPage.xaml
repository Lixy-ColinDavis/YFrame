<UserControl x:Class="YFrame.Installer.Views.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YFrame.Installer.Controls"
             Height="450" Width="700">

    <Grid>
        <controls:ParticleBackground ParticleCount="80">
            <controls:ParticleBackground.ParticleColor>
                <SolidColorBrush Color="#FF6B6B"/>
            </controls:ParticleBackground.ParticleColor>
        </controls:ParticleBackground>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <Border x:Name="LoadingCircle" Width="64" Height="64"
                    HorizontalAlignment="Center" Margin="0,0,0,24"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Border.RenderTransform>
                <Border CornerRadius="32" Width="64" Height="64"
                        BorderBrush="#4D96FF" BorderThickness="3" Background="Transparent">
                    <Border.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="Transparent" Offset="0.7"/>
                            <GradientStop Color="White" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.OpacityMask>
                </Border>
            </Border>

            <TextBlock x:Name="StatusText" Text="准备安装..."
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="#E6EDF3" HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock x:Name="DetailStatusText" Text=""
                       FontSize="12" Foreground="#8B949E"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       TextTrimming="CharacterEllipsis" MaxWidth="450"/>

            <controls:RainbowProgressBar x:Name="ProgressBar"/>

            <ScrollViewer x:Name="LogViewer" MaxHeight="120"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="LogText" FontSize="11"
                           Foreground="#6E7681" FontFamily="Consolas"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
