<UserControl x:Class="YFrame.Installer.Controls.RainbowProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Storyboard x:Key="ScanAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanLine"
                             Storyboard.TargetProperty="(Canvas.Left)"
                             From="-30" To="500" Duration="0:0:1.5"/>
        </Storyboard>
    </UserControl.Resources>

    <Border CornerRadius="6" Background="#1A1E24" Padding="1">
        <Grid>
            <Border x:Name="TrackBorder" CornerRadius="5" Background="#252A33" Height="18"/>
            <Border x:Name="ProgressBorder" CornerRadius="5" Height="18"
                    HorizontalAlignment="Left" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4D96FF" Offset="0"/>
                        <GradientStop Color="#9B59B6" Offset="0.5"/>
                        <GradientStop Color="#FF6B6B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas ClipToBounds="True" Margin="0">
                <Border x:Name="ScanLine" Width="30" Height="18" Opacity="0.3"
                        Canvas.Top="0" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="White" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Canvas>
            <TextBlock x:Name="PercentText" Text="0%"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold"/>
        </Grid>
    </Border>
</UserControl>
