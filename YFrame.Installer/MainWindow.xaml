<Window x:Class="YFrame.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YFrame.Installer.Views"
        Title="YFrame 框架 安装程序"
        Width="720" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#0D1117"
            BorderBrush="#30363D" BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#161B22"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <TextBlock Text="YFrame 框架 安装程序"
                               FontSize="12" Foreground="#8B949E"
                               VerticalAlignment="Center"/>
                    <Button Content="&#x2715;" Width="32" Height="24"
                            Background="Transparent" Foreground="#8B949E"
                            BorderThickness="0" FontSize="14" Cursor="Hand"
                            HorizontalAlignment="Right" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Name="border">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#DA3633"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="PageHost"/>

            <Border Grid.Row="2" Background="#161B22"
                    Visibility="{Binding ShowNavigationButtons, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="30,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="Step0" IsChecked="True" IsEnabled="False"
                                     GroupName="Steps" Style="{StaticResource {x:Type RadioButton}}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            x:Name="circle" Background="#21262D"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="circle" Property="Background" Value="#4D96FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                        <TextBlock Text="1" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="-22,0,0,0" IsHitTestVisible="False"/>
                        <Rectangle Width="40" Height="2" Fill="#30363D" Margin="6,0"/>

                        <RadioButton x:Name="Step1" IsEnabled="False"
                                     GroupName="Steps" Style="{StaticResource {x:Type RadioButton}}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            x:Name="circle" Background="#21262D"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="circle" Property="Background" Value="#4D96FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                        <TextBlock Text="2" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="-22,0,0,0" IsHitTestVisible="False"/>
                        <Rectangle Width="40" Height="2" Fill="#30363D" Margin="6,0"/>

                        <RadioButton x:Name="Step2" IsEnabled="False"
                                     GroupName="Steps" Style="{StaticResource {x:Type RadioButton}}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            x:Name="circle" Background="#21262D"/>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                        <TextBlock Text="3" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="-22,0,0,0" IsHitTestVisible="False"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource NavButton}"
                                Background="#21262D" Foreground="#C9D1D9"
                                BorderBrush="#30363D" BorderThickness="1"
                                Command="{Binding CancelCommand}" Margin="0,0,8,0"/>

                        <Button Content="上一步" Style="{StaticResource NavButton}"
                                Background="#21262D" Foreground="#C9D1D9"
                                BorderBrush="#30363D" BorderThickness="1"
                                Command="{Binding BackCommand}"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,8,0"/>

                        <Button Content="{Binding NextButtonText}" Style="{StaticResource NavButton}"
                                Background="#238636" Foreground="White" FontWeight="SemiBold"
                                BorderBrush="#238636" BorderThickness="1"
                                Command="{Binding NextCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
