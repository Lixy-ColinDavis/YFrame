<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>YFrame.update</AssemblyName>
    <RootNamespace>YFrame.Update</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用主框架主题和控件样式，保持更新窗口与 YFrame 一致 -->
    <Resource Include="..\YFrame\Common\Themes\CloudWhiteTheme.xaml" Link="Themes\CloudWhiteTheme.xaml" />
    <Resource Include="..\YFrame\Common\Themes\ControlStyles.xaml" Link="Themes\ControlStyles.xaml" />
    <Resource Include="..\YFrame\Common\Images\Logo.png" Link="Assets\Logo.png" />
    <!-- 更新地址唯一默认来源，与 YFrame 共用一份代码 -->
    <Compile Include="..\YF_Manager\Common\UpdateDefaults.cs" Link="Common\UpdateDefaults.cs" />
  </ItemGroup>

  <!-- Debug 构建后把更新器放到 YFrame 输出根目录，便于主程序直接启动 -->
  <Target Name="CopyUpdaterToYFrameDebugOutput" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <UpdaterRuntimeFiles Include="$(TargetDir)YFrame.update.exe" />
      <UpdaterRuntimeFiles Include="$(TargetDir)YFrame.update.dll" />
      <UpdaterRuntimeFiles Include="$(TargetDir)YFrame.update.deps.json" />
      <UpdaterRuntimeFiles Include="$(TargetDir)YFrame.update.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterRuntimeFiles)"
          DestinationFolder="$(MSBuildProjectDirectory)\..\YFrame\bin\Debug\net8.0-windows\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

