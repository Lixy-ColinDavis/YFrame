<Window x:Class="YFrame.Update.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YFrame Update"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        Icon="Assets/Logo.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="YF" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="YFrame Update" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource BadgeBorder}" Margin="12,0,0,0">
                            <TextBlock Text="AUTO UPDATE" FontSize="8.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                            Content="✕" ToolTip="关闭"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsEnabled="False"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 更新进度 -->
            <Border Grid.Row="1" Margin="24,20,24,22" Style="{StaticResource CardBorder}"
                    Padding="24,22">
                <StackPanel>
                    <TextBlock Text="正在更新 YFrame" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="VersionText" Text="正在检查更新..."
                               FontSize="11"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="0,6,0,0"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="UpdateProgressBar" Height="8"
                                     Minimum="0" Maximum="100" Value="0"
                                     Background="{DynamicResource PanelAltBrush}"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="PercentText" Grid.Column="1"
                                   Text="0%" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="StatusText" Text="准备更新..."
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,18,0,0"/>
                    <TextBlock x:Name="DetailText" Text="正在初始化更新流程..."
                               FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}"
                               TextWrapping="Wrap" Margin="0,5,0,0"
                               MinHeight="32"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}"
                            Margin="0,16,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="下载" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="  →  校验  →  备份  →  替换  →  删除  →  重启"
                                   Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
