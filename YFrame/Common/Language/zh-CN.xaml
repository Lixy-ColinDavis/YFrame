    <sys:String x:Key="key_KMS_Output">输出</sys:String>
    <sys:String x:Key="key_KMS_Debug">调试</sys:String>
    <sys:String x:Key="key_KMS_DragHint">拖拽鼠标框选截图区域&#x0a;按 ESC 取消</sys:String>

    <!--OCR实时翻译-->
    <sys:String x:Key="key_OCR_Title">OCR 实时翻译</sys:String>
    <sys:String x:Key="key_OCR_Subtitle">English → 中文</sys:String>
    <sys:String x:Key="key_OCR_Steps">📋 操作步骤</sys:String>
    <sys:String x:Key="key_OCR_Step1Title">在框架中开启热键并按下 Ctrl+Y</sys:String>
    <sys:String x:Key="key_OCR_Step1Desc">点击框架工具栏 '热键监控: 开'，然后按下 Ctrl + Y 启动截图翻译模式</sys:String>
    <sys:String x:Key="key_OCR_Step2Title">框选翻译区域</sys:String>
    <sys:String x:Key="key_OCR_Step2Desc">按住鼠标左键拖拽，选择屏幕上要翻译的英文区域</sys:String>
    <sys:String x:Key="key_OCR_Step3Title">自动识别翻译</sys:String>
    <sys:String x:Key="key_OCR_Step3Desc">松开鼠标后自动进行 OCR 识别并显示中文翻译结果</sys:String>
    <sys:String x:Key="key_OCR_Hint">💡 提示：翻译结果窗口中点击任意位置即可关闭；热键 Ctrl+Y 由框架统一管理</sys:String>
    <sys:String x:Key="key_OCR_ScreenShotTitle">📷 截图翻译</sys:String>
    <sys:String x:Key="key_OCR_ScreenHint">按住鼠标左键拖拽，框选需要翻译的英文区域</sys:String>
    <sys:String x:Key="key_OCR_ReleaseHint">释放鼠标后自动识别并翻译</sys:String>
    <sys:String x:Key="key_OCR_ESCCancel">按 ESC 取消截图</sys:String>
    <sys:String x:Key="key_OCR_ShowTextHint">💡 点击任意位置或按 ESC 关闭翻译结果</sys:String>

