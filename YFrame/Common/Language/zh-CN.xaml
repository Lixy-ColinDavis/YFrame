    <sys:String x:Key="key_KMS_RunScript">▶ 运行脚本</sys:String>
    <sys:String x:Key="key_KMS_Stop">⏹ 停止</sys:String>
    <sys:String x:Key="key_KMS_ClearOutput">🗑 清空输出</sys:String>
