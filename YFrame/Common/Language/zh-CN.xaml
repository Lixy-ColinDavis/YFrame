    <!--HTTP服务器-->
    <sys:String x:Key="key_Http_FilePath">文件路径</sys:String>
    <sys:String x:Key="key_Http_StartServer">开启服务器</sys:String>
    <sys:String x:Key="key_Http_CloseServer">关闭服务器</sys:String>
    <sys:String x:Key="key_Http_ServerConfig">服务器配置</sys:String>
    <sys:String x:Key="key_Http_LocalIP">本机 IP:</sys:String>
    <sys:String x:Key="key_Http_Port">端口:</sys:String>
    <sys:String x:Key="key_Http_OpenFolder">打开文件夹</sys:String>
    <sys:String x:Key="key_Http_DragHint">从资源管理器拖拽文件或目录到此处，将自动复制到文件路径目录</sys:String>
    <sys:String x:Key="key_Http_DragPlaceholder">📥 拖拽文件到此处以上传</sys:String>
    <sys:String x:Key="key_Http_AdminHint">请在 PowerShell 管理员权限下执行</sys:String>
