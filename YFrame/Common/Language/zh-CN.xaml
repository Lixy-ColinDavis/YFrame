    <sys:String x:Key="key_Clicker_Title">鼠标连点器</sys:String>
    <sys:String x:Key="key_Clicker_Interval">点击间隔：</sys:String>
    <sys:String x:Key="key_Clicker_Start">开始点击</sys:String>
    <sys:String x:Key="key_Clicker_Stop">停止点击</sys:String>
    <sys:String x:Key="key_Clicker_HotkeyHint">框架热键：Ctrl+Y 切换连点器启停</sys:String>

