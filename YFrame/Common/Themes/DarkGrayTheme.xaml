<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         风格一：暗夜科技（深蓝 + 青色霓虹）
         对应设计稿 s1：窗口 #0D1220，青色强调 #22D3EE，紫色氛围光
         ============================================================ -->

    <!-- 窗口外壳与主内容背景 -->
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0D1220" Offset="0"/>
        <GradientStop Color="#FF0A0F1B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF0A0F1B"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF0D1220"/>
    <SolidColorBrush x:Key="MenuBarBrush" Color="#FF0D1220"/>
    <SolidColorBrush x:Key="ToolWindowBrush" Color="#FF101728"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1FFFFFFF"/>

    <!-- 卡片 / 面板层级 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FF111827"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF161E30"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#FF1B2438"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#14FFFFFF"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F4FA"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF8E96AC"/>

    <!-- 强调色与状态色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF22D3EE"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF04222B"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A22D3EE"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF06B6D4" Offset="0"/>
        <GradientStop Color="#FF0891B2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#00000000"/>
    <!-- 插件图标叠加色：终端主题下统一染绿，其余主题保持原色 -->
    <SolidColorBrush x:Key="PluginIconTintBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF34D399"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFB7185"/>

    <!-- 列表项交互色 -->
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#1A22D3EE"/>
    <SolidColorBrush x:Key="TreeItemAccent" Color="#FF22D3EE"/>
    <SolidColorBrush x:Key="TreeItemSecondaryText" Color="#FF8E96AC"/>

    <!-- 图表色 -->
    <SolidColorBrush x:Key="ChartLine1" Color="#FF22D3EE"/>
    <SolidColorBrush x:Key="ChartLine2" Color="#FF8B5CF6"/>
    <SolidColorBrush x:Key="ChartFill1" Color="#3322D3EE"/>
    <SolidColorBrush x:Key="ChartFill2" Color="#338B5CF6"/>
    <SolidColorBrush x:Key="ChartGrid" Color="#14FFFFFF"/>

    <!-- 状态栏 / 日志 -->
    <SolidColorBrush x:Key="StatusBarBg" Color="#FF0A0F1B"/>
    <SolidColorBrush x:Key="LogTimeBrush" Color="#FF5F6678"/>
    <SolidColorBrush x:Key="LogSourceBrush" Color="#FF22D3EE"/>

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="52" ShadowDepth="10"
                      Opacity="0.62" Color="#FF000000" Direction="270"/>

    <!-- 窗口背景氛围光（低透明径向渐变，配合 Ellipse + BlurEffect 使用） -->
    <RadialGradientBrush x:Key="GlowBrush1" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#6622D3EE" Offset="0"/>
        <GradientStop Color="#0022D3EE" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush2" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#667C3AED" Offset="0"/>
        <GradientStop Color="#007C3AED" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
