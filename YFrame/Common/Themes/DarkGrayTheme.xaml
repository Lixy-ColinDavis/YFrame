<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 黑灰主题 — 参照 VS Code Dark 配色标准，纯黑灰无彩色倾向 -->
    <!-- 主内容区：VS Code 编辑器背景 #1E1E1E -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1E1E1E"/>
    <!-- 菜单栏 / 状态栏：VS Code 标题栏 #2D2D2D -->
    <SolidColorBrush x:Key="MenuBarBrush" Color="#FF2D2D2D"/>
    <!-- 侧边栏 / 工具箱面板：VS Code 侧边栏 #252526 -->
    <SolidColorBrush x:Key="ToolWindowBrush" Color="#FF252526"/>
    <!-- 边框 / 分隔线：VS Code 边框色 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3E3E3E"/>
    <!-- 主文字色：VS Code 前景色 #CCCCCC -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFCCCCCC"/>
    <!-- === 列表项交互色（VS 2022 风格树形列表）=== -->
    <!-- 鼠标悬停背景 -->
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#FF2A2D2E"/>
    <!-- 选中项背景 -->
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#FF04395E"/>
    <!-- 选中项左侧指示条 / 强调色 -->
    <SolidColorBrush x:Key="TreeItemAccent" Color="#FF0078D4"/>
    <!-- 列表项次级文字色 -->
    <SolidColorBrush x:Key="TreeItemSecondaryText" Color="#FF8B949E"/>
</ResourceDictionary>
