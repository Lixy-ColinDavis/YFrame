<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         风格二：云白简约（浅色 + 靛蓝）
         对应设计稿 s2：白色窗口 / #F7F9FD 内容，靛蓝强调 #4F46E5
         ============================================================ -->

    <!-- 窗口外壳与主内容背景 -->
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFBFCFE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF7F9FD"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MenuBarBrush" Color="#FFFFFFFF"/>
    <!-- 顶部菜单栏专用底色：比侧边栏更不透明，保证文字可读 -->
    <SolidColorBrush x:Key="TopBarBrush" Color="#FFFFFFFF"/>
    <!-- 菜单/下拉浮层专用底色 -->
    <SolidColorBrush x:Key="MenuPanelBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToolWindowBrush" Color="#FFF7F9FD"/>
    <!-- 窗口外框透明：浅色主题下避免关闭按钮悬停时出现白色描边，边缘由阴影区分 -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#00000000"/>

    <!-- 卡片 / 面板层级 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFEEF1F7"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#FFF3F5FA"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFF0F4FF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE6E9F2"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF1C2030"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF6B7280"/>

    <!-- 强调色与状态色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#144F46E5"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6366F1" Offset="0"/>
        <GradientStop Color="#FF4F46E5" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#00000000"/>
    <!-- 插件图标叠加色：终端主题下统一染绿，其余主题保持原色 -->
    <SolidColorBrush x:Key="PluginIconTintBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF059669"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB45309"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE11D48"/>

    <!-- 列表项交互色 -->
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#0D0F1432"/>
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#144F46E5"/>
    <SolidColorBrush x:Key="TreeItemAccent" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="TreeItemSecondaryText" Color="#FF6B7280"/>

    <!-- 图表色 -->
    <SolidColorBrush x:Key="ChartLine1" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="ChartLine2" Color="#FFEC4899"/>
    <SolidColorBrush x:Key="ChartFill1" Color="#1F4F46E5"/>
    <SolidColorBrush x:Key="ChartFill2" Color="#1FEC4899"/>
    <SolidColorBrush x:Key="ChartGrid" Color="#0D0F1432"/>

    <!-- 状态栏 / 日志 -->
    <SolidColorBrush x:Key="StatusBarBg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LogTimeBrush" Color="#FF9AA3B8"/>
    <SolidColorBrush x:Key="LogSourceBrush" Color="#FF4F46E5"/>

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFontFamily">DengXian</FontFamily>
    <FontFamily x:Key="MonoFontFamily">DengXian</FontFamily>
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="42" ShadowDepth="10"
                      Opacity="0.22" Color="#FF192350" Direction="270"/>

    <!-- 窗口背景氛围光 -->
    <RadialGradientBrush x:Key="GlowBrush1" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#336366F1" Offset="0"/>
        <GradientStop Color="#006366F1" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush2" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#26EC4899" Offset="0"/>
        <GradientStop Color="#00EC4899" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
