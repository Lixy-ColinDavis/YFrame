<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 绿白主题 — "翠火青绿" · 暗绿基底，翡翠绿光作为星火化身 -->
    <!-- 主内容区背景 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF0A1410"/>
    <!-- 菜单栏 / 面板 / 卡片背景 -->
    <SolidColorBrush x:Key="MenuBarBrush" Color="#FF0F1E18"/>
    <!-- 侧边栏 / 工具箱面板 -->
    <SolidColorBrush x:Key="ToolWindowBrush" Color="#FF0F1E18"/>
    <!-- 边框 / 分隔线 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF1A3828"/>
    <!-- 主文字色 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFD8F0E0"/>

    <!-- === 列表项交互色 === -->
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#FF142A20"/>
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#FF0A2A1A"/>
    <SolidColorBrush x:Key="TreeItemAccent" Color="#FF00E676"/>
    <SolidColorBrush x:Key="TreeItemSecondaryText" Color="#FF6EA882"/>

    <!-- === 图表色 === -->
    <SolidColorBrush x:Key="ChartLine1" Color="#FF00E676"/>
    <SolidColorBrush x:Key="ChartLine2" Color="#FF00C853"/>
    <SolidColorBrush x:Key="ChartFill1" Color="#1200E676"/>
    <SolidColorBrush x:Key="ChartFill2" Color="#0D00C853"/>
    <SolidColorBrush x:Key="ChartGrid" Color="#0AFFFFFF"/>

    <!-- === 状态栏 === -->
    <SolidColorBrush x:Key="StatusBarBg" Color="#FF081210"/>

    <!-- === 日志色 === -->
    <SolidColorBrush x:Key="LogTimeBrush" Color="#FF3D7858"/>
    <SolidColorBrush x:Key="LogSourceBrush" Color="#FF00E070"/>
</ResourceDictionary>
