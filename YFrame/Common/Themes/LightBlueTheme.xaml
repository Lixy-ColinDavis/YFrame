<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         风格四：玻璃拟态（彩色渐变 + 毛玻璃）
         对应设计稿 s4：紫粉渐变背景，半透明白色面板，紫粉强调色
         ============================================================ -->

    <!-- 窗口外壳与主内容背景（半透明，透出背景渐变） -->
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E62B1055" Offset="0"/>
        <GradientStop Color="#E646227A" Offset="0.45"/>
        <GradientStop Color="#E6752D8F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="MenuBarBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="ToolWindowBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#33FFFFFF"/>

    <!-- 卡片 / 面板层级 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#29FFFFFF"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A8FFFFFF"/>

    <!-- 强调色与状态色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC084FC"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#29C084FC"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8B5CF6" Offset="0"/>
        <GradientStop Color="#FFEC4899" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#00000000"/>
    <!-- 插件图标叠加色：终端主题下统一染绿，其余主题保持原色 -->
    <SolidColorBrush x:Key="PluginIconTintBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFCD34D"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFB7185"/>

    <!-- 列表项交互色 -->
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#29C084FC"/>
    <SolidColorBrush x:Key="TreeItemAccent" Color="#FFC084FC"/>
    <SolidColorBrush x:Key="TreeItemSecondaryText" Color="#A8FFFFFF"/>

    <!-- 图表色 -->
    <SolidColorBrush x:Key="ChartLine1" Color="#FFC084FC"/>
    <SolidColorBrush x:Key="ChartLine2" Color="#FFF472B6"/>
    <SolidColorBrush x:Key="ChartFill1" Color="#33C084FC"/>
    <SolidColorBrush x:Key="ChartFill2" Color="#33F472B6"/>
    <SolidColorBrush x:Key="ChartGrid" Color="#1FFFFFFF"/>

    <!-- 状态栏 / 日志 -->
    <SolidColorBrush x:Key="StatusBarBg" Color="#1A000000"/>
    <SolidColorBrush x:Key="LogTimeBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="LogSourceBrush" Color="#FFE9D5FF"/>

    <!-- 字体与阴影 -->
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="70" ShadowDepth="14"
                      Opacity="0.55" Color="#FF0F0528" Direction="270"/>

    <!-- 窗口背景氛围光 -->
    <RadialGradientBrush x:Key="GlowBrush1" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#668B5CF6" Offset="0"/>
        <GradientStop Color="#008B5CF6" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush2" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#59EC4899" Offset="0"/>
        <GradientStop Color="#00EC4899" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
