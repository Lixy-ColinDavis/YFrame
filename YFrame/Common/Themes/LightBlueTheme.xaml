<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅蓝主题 — 参照 Windows 11 系统配色，清爽现代的蓝白风格 -->
    <!-- 主内容区：Windows 11 Mica 云母材质下的近白色 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFAFBFD"/>
    <!-- 菜单栏 / 状态栏：Windows 11 标题栏淡蓝底色 -->
    <SolidColorBrush x:Key="MenuBarBrush" Color="#FFEDF2F9"/>
    <!-- 侧边栏 / 工具箱面板：Windows 11 导航面板色调 -->
    <SolidColorBrush x:Key="ToolWindowBrush" Color="#FFE1E9F3"/>
    <!-- 边框 / 分隔线：Windows 11 边框色 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FFCDD8E8"/>
    <!-- 主文字色：Windows 11 系统文字色 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF1F1F1F"/>
    <!-- === 列表项交互色（VS 2022 风格树形列表）=== -->
    <!-- 鼠标悬停背景 -->
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#FFE5EDF7"/>
    <!-- 选中项背景 -->
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#FFCDDEF5"/>
    <!-- 选中项左侧指示条 / 强调色 -->
    <SolidColorBrush x:Key="TreeItemAccent" Color="#FF0066C4"/>
    <!-- 列表项次级文字色 -->
    <SolidColorBrush x:Key="TreeItemSecondaryText" Color="#FF6A6A6A"/>
</ResourceDictionary>
