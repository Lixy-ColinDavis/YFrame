<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 米白主题 — 参照 VS Code Light 配色标准，纯净明亮的浅色系 -->
    <!-- 主内容区：VS Code Light 编辑器背景 #FFFFFF -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFFFF"/>
    <!-- 菜单栏 / 状态栏：VS Code Light 标题栏 #F3F3F3 -->
    <SolidColorBrush x:Key="MenuBarBrush" Color="#FFF3F3F3"/>
    <!-- 侧边栏 / 工具箱面板：VS Code Light 侧边栏色调 -->
    <SolidColorBrush x:Key="ToolWindowBrush" Color="#FFECECEC"/>
    <!-- 边框 / 分隔线 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0"/>
    <!-- 主文字色：VS Code Light 前景色 #333333 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF333333"/>
    <!-- === 列表项交互色（VS 2022 风格树形列表）=== -->
    <!-- 鼠标悬停背景 -->
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#FFE8E8E8"/>
    <!-- 选中项背景 -->
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#FFCAD5EB"/>
    <!-- 选中项左侧指示条 / 强调色 -->
    <SolidColorBrush x:Key="TreeItemAccent" Color="#FF0078D4"/>
    <!-- 列表项次级文字色 -->
    <SolidColorBrush x:Key="TreeItemSecondaryText" Color="#FF6E6E6E"/>
</ResourceDictionary>
