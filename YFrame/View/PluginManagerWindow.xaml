<Window x:Class="YFrame.View.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YFrame.View"
        Title="{DynamicResource key_PluginManager_Title}" Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Common/Images/Logo.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 顶部：服务器连接区域 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolWindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource key_PluginManager_ServerURL}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Grid.Column="0" Margin="0,0,12,0"/>

                    <TextBox x:Name="txtServerURL" Text=""
                             FontFamily="Consolas" FontSize="13"
                             Height="32" VerticalAlignment="Center" Grid.Column="1"
                             VerticalContentAlignment="Center"/>

                    <Button x:Name="btnConnect" Content="{DynamicResource key_PluginManager_Connect}"
                            Click="BtnConnect_Click" Width="80" Height="32"
                            Grid.Column="2" Margin="8,0"/>

                    <Button x:Name="btnDisconnect" Content="{DynamicResource key_PluginManager_Disconnect}"
                            Click="BtnDisconnect_Click" Width="80" Height="32"
                            Grid.Column="3" Margin="0,0,8,0" IsEnabled="False"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="4" MinWidth="120">
                        <Ellipse x:Name="statusDot" Width="10" Height="10"
                                 Fill="Gray" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatus" Text="{DynamicResource key_PluginManager_NotConnected}" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource key_PluginManager_Hint}"
                           FontSize="12" Foreground="{DynamicResource TextBrush}" Opacity="0.5"/>
            </StackPanel>
        </Border>

        <!-- 底部：状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolWindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtPluginCount" Text="" FontSize="12"
                           Foreground="{DynamicResource TextBrush}" Opacity="0.6"/>
                <Separator Width="1" Margin="12,0" Opacity="0.3"/>
                <TextBlock x:Name="txtDownloadStatus" Text="" FontSize="12"
                           Foreground="{DynamicResource TextBrush}" Opacity="0.6"/>
            </StackPanel>
        </Border>

        <!-- 中间：插件列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- 表头 -->
                <Border Background="{DynamicResource ToolWindowBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource key_PluginManager_ColName}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Grid.Column="0"/>
                        <TextBlock Text="{DynamicResource key_PluginManager_ColFileCount}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Grid.Column="1" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource key_PluginManager_ColSize}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Grid.Column="2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource key_PluginManager_ColAction}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Grid.Column="3" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 插件列表 -->
                <ItemsControl x:Name="itemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,10" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PluginName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding PluginId}" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.5"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding FileCountDisplay}" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Grid.Column="1"/>

                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Grid.Column="2"/>

                                    <Grid Grid.Column="3" Margin="8,0">
                                        <Button Content="{DynamicResource key_PluginManager_Download}"
                                                Width="100" Height="30"
                                                Click="BtnDownload_Click"
                                                Tag="{Binding}"
                                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"
                                                HorizontalAlignment="Center"/>

                                        <TextBlock Text="{DynamicResource key_PluginManager_Installed}"
                                                   FontSize="13"
                                                   Foreground="#FF4CAF50" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    VerticalAlignment="Center">
                                            <ProgressBar Width="120" Height="6"
                                                         Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                                                         Foreground="#FF0078D4"
                                                         Background="{DynamicResource BorderBrush}"/>
                                            <TextBlock Text="{Binding DownloadProgressText}" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}" Opacity="0.6"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空列表提示 -->
                <TextBlock x:Name="txtEmpty" Text="{DynamicResource key_PluginManager_Empty}"
                           FontSize="14"
                           Foreground="{DynamicResource TextBrush}" Opacity="0.4"
                           HorizontalAlignment="Center" Margin="0,40,0,0"
                           Visibility="Visible">
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
