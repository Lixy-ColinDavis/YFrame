<Window x:Class="YFrame.View.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:YFrame.View"
        Title="{DynamicResource key_PluginManager_Title}" Height="700" Width="940"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Common/Images/Logo.ico">

    <!-- 自定义窗口边框但保留系统级拖拽边缘缩放 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 标题栏窗口按钮 -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{DynamicResource PanelHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" CornerRadius="14"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            Effect="{DynamicResource WindowShadow}">
        <Grid>
            <!-- 背景氛围光 -->
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-160,-170,0,0" Fill="{DynamicResource GlowBrush1}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-150,-150" Fill="{DynamicResource GlowBrush2}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <DockPanel LastChildFill="True">
                <!-- ================= 标题栏 ================= -->
                <Border DockPanel.Dock="Top" Height="46"
                        Background="{DynamicResource TitleBarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="16,0,0,0" IsHitTestVisible="False">
                            <Border Width="26" Height="26" CornerRadius="8"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <TextBlock Text="PM" Foreground="White" FontSize="9.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource key_PluginManager_Title}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- 拖拽区域 -->
                        <Border Background="Transparent" Margin="150,0,220,0"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                        <!-- 连接状态 + 窗口按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,88,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding StatusText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    ToolTipService.IsEnabled="False">
                            <Button Style="{StaticResource TitleBarButton}" Content="─"
                                    Click="Minimize_Click"
                                    AutomationProperties.Name="{DynamicResource key_Minimize}"/>
                            <Button Style="{StaticResource TitleBarCloseButton}" Content="✕"
                                    Click="Close_Click"
                                    AutomationProperties.Name="{DynamicResource key_Close}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 底部状态栏 ================= -->
                <Border DockPanel.Dock="Bottom" Height="30"
                        Background="{DynamicResource StatusBarBg}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PluginCountText}" FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PluginCountText}"/>
                            <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}"
                                    Margin="12,0"/>
                            <TextBlock Text="{Binding DownloadStatusText}" FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       MaxWidth="480" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DownloadStatusText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 内容 ================= -->
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 服务器连接卡片 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource key_PluginManager_Title}"
                                               Style="{StaticResource SectionTitle}" FontSize="15"/>
                                    <Border Style="{StaticResource BadgeBorder}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding AddressLabel}"
                                                   Style="{StaticResource MonoText}" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ModeHint}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" MaxWidth="420"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ModeHint}"/>
                            </Grid>

                            <!-- 来源模式 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource key_PluginManager_Mode}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton Content="{DynamicResource key_PluginManager_Tcp}"
                                             GroupName="PluginSourceMode"
                                             IsChecked="{Binding IsTcpMode, Mode=TwoWay}"
                                             VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <RadioButton Content="{DynamicResource key_PluginManager_Https}"
                                             GroupName="PluginSourceMode"
                                             IsChecked="{Binding IsHttpsMode, Mode=TwoWay}"
                                             VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding CurrentAddress, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="13"
                                         Height="36" VerticalContentAlignment="Center"
                                         ToolTip="{Binding CurrentAddress}"/>

                                <Button Grid.Column="1" Content="{DynamicResource key_PluginManager_Connect}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ConnectCommand}"
                                        IsEnabled="{Binding CanConnect}"
                                        Height="36" MinWidth="96" Margin="10,0,0,0"/>

                                <Button Grid.Column="2" Content="{DynamicResource key_PluginManager_Disconnect}"
                                        Command="{Binding DisconnectCommand}"
                                        IsEnabled="{Binding IsConnected}"
                                        Height="36" MinWidth="96" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 插件列表卡片 -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                        <DockPanel>
                            <!-- 卡片标题 -->
                            <Border DockPanel.Dock="Top" Height="46"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <TextBlock Text="{DynamicResource key_PluginManager_ListTitle}"
                                               Style="{StaticResource SectionTitle}" FontSize="14"/>
                                    <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding PluginCountText}"
                                                   Style="{StaticResource MonoText}" FontSize="10"
                                                   MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 表头 -->
                            <Border DockPanel.Dock="Top" Height="34"
                                    Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource key_PluginManager_ColName}"
                                               Style="{StaticResource MutedText}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource key_PluginManager_ColFileCount}"
                                               Style="{StaticResource MutedText}" FontSize="10.5"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource key_PluginManager_ColSize}"
                                               Style="{StaticResource MutedText}" FontSize="10.5"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{DynamicResource key_PluginManager_ColAction}"
                                               Style="{StaticResource MutedText}" FontSize="10.5"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 列表 -->
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RemotePlugins}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1" Padding="18,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="150"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 名称 + ID -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Border Width="30" Height="30" CornerRadius="8"
                                                                    Background="{Binding IconBrush}">
                                                                <Grid>
                                                                    <!-- 终端主题下叠加绿色，统一图标色调 -->
                                                                    <Border Background="{DynamicResource PluginIconTintBrush}"
                                                                            CornerRadius="8"/>
                                                                    <TextBlock Text="{Binding IconText}"
                                                                               Foreground="White" FontSize="10.5"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PluginName}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                                <TextBlock Text="{Binding PluginId}"
                                                                           Style="{StaticResource MonoText}"
                                                                           FontSize="10" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding FileCountDisplay}"
                                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}"
                                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <Grid Grid.Column="3">
                                                            <!-- 下载按钮 -->
                                                            <Button Content="{DynamicResource key_PluginManager_Download}"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    Height="30" MinHeight="30" Width="104"
                                                                    Padding="10,3" FontSize="11.5"
                                                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                            <!-- 已安装徽标 -->
                                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Background="{DynamicResource AccentSoftBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="6"
                                                                    Padding="10,3"
                                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{DynamicResource key_PluginManager_Installed}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource SuccessBrush}"/>
                                                            </Border>

                                                            <!-- 下载进度 -->
                                                            <StackPanel VerticalAlignment="Center"
                                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <ProgressBar Width="120" Height="6"
                                                                             Value="{Binding DownloadProgress}"
                                                                             Minimum="0" Maximum="100"/>
                                                                <TextBlock Text="{Binding DownloadProgressText}"
                                                                           Style="{StaticResource MonoText}"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 空状态 -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Width="54" Height="54" CornerRadius="16"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="⇄" FontSize="24"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource key_PluginManager_Empty}"
                                               Style="{StaticResource MutedText}" FontSize="12"
                                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
