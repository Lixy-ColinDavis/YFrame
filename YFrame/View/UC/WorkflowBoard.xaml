<UserControl x:Class="YFrame.View.UC.WorkflowBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource UiFontFamily}">

    <UserControl.Resources>
        <Style x:Key="FlowToolButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SelectedFlow.Name, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Height="28" Margin="0,0,10,0"
                             FontSize="12" FontWeight="SemiBold"
                             ToolTip="流程名称，修改后自动保存"/>
                    <Button Content="+ 添加步骤" Style="{StaticResource FlowToolButton}"
                            Command="{Binding AddStepCommand}"/>
                    <Button Content="自动布局" Style="{StaticResource FlowToolButton}"
                            Command="{Binding AutoLayoutCommand}"/>
                    <Button Content="重置完成" Style="{StaticResource FlowToolButton}"
                            Command="{Binding ResetCompletedCommand}"/>
                    <Button Content="复制流程" Style="{StaticResource FlowToolButton}"
                            Command="{Binding DuplicateFlowCommand}"/>
                    <Button Content="复位视图" Style="{StaticResource FlowToolButton}"
                            Click="FitButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <ProgressBar Width="130" Height="6"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 画布 -->
        <Border x:Name="BoardViewport" Grid.Row="1" ClipToBounds="True"
                Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <Canvas x:Name="BoardRoot"
                        Width="4000" Height="2600"
                        Background="Transparent"
                        MouseWheel="BoardRoot_MouseWheel"
                        MouseLeftButtonDown="BoardRoot_MouseLeftButtonDown"
                        MouseLeftButtonUp="BoardRoot_MouseLeftButtonUp"
                        MouseMove="BoardRoot_MouseMove">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BoardScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="BoardPan" X="0" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Canvas x:Name="EdgeCanvas" Width="4000" Height="2600"/>
                    <Canvas x:Name="NodeCanvas" Width="4000" Height="2600"/>
                </Canvas>

                <TextBlock x:Name="EmptyTip"
                           Text="双击画布空白处添加第一个步骤，或点击“添加步骤”"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- 节点编辑浮层 -->
                <Border x:Name="EditorOverlay"
                        Background="#66000000"
                        Visibility="Collapsed">
                    <Border Style="{StaticResource CardBorder}"
                            Width="360"
                            Padding="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="编辑步骤" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="步骤内容" Style="{StaticResource MutedText}" Margin="0,12,0,5"/>
                            <TextBox x:Name="NodeTitleBox" MaxLength="60"/>
                            <TextBlock Text="备注 / 注释" Style="{StaticResource MutedText}" Margin="0,10,0,5"/>
                            <TextBox x:Name="NodeNoteBox" MaxLength="120"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                            <CheckBox x:Name="NodeDoneBox" Content="已完成"
                                      Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="删除步骤" Margin="0,0,8,0"
                                        Click="DeleteNodeButton_Click"/>
                                <Button Content="取消" Margin="0,0,8,0"
                                        Click="CancelNodeButton_Click"/>
                                <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                        Click="SaveNodeButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding SaveStatus}" FontSize="10"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedFlow.Name}" FontSize="10"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="360"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
