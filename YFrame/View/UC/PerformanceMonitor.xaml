<UserControl x:Class="YFrame.PerformanceMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="280"
             FontFamily="{DynamicResource UiFontFamily}">
    <Grid Margin="12,8,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CPU 数值 -->
        <Grid Grid.Row="0">
            <TextBlock Text="CPU" FontSize="10.5" FontWeight="Bold"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       VerticalAlignment="Bottom"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <TextBlock x:Name="Txt_CpuValue" Text="--"
                           FontFamily="{DynamicResource MonoFontFamily}"
                           FontSize="21" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="%" FontSize="10.5" Margin="3,0,0,2"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

        <!-- CPU 曲线（无坐标轴标签，保持设计稿的 sparkline 观感） -->
        <lvc:CartesianChart Grid.Row="1" Height="62" Margin="0,6,0,0"
                            Series="{Binding SeriesCollection}"
                            LegendLocation="None"
                            Background="Transparent"
                            Foreground="{DynamicResource SubtleTextBrush}"
                            DisableAnimations="True">
            <lvc:CartesianChart.AxisY>
                <lvc:Axis MinValue="0" MaxValue="100"
                          ShowLabels="False"
                          FontSize="8"
                          Foreground="{DynamicResource SubtleTextBrush}"/>
            </lvc:CartesianChart.AxisY>
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Labels="{Binding Labels}"
                          ShowLabels="False"
                          FontSize="8"
                          Foreground="{DynamicResource SubtleTextBrush}"/>
            </lvc:CartesianChart.AxisX>
        </lvc:CartesianChart>

        <!-- 内存数值 -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <TextBlock Text="内存" FontSize="10.5" FontWeight="Bold"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       VerticalAlignment="Bottom"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <TextBlock x:Name="Txt_MemUsed" Text="--"
                           FontFamily="{DynamicResource MonoFontFamily}"
                           FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="Txt_MemTotal" Text=""
                           FontFamily="{DynamicResource MonoFontFamily}"
                           FontSize="10" Margin="4,0,0,2"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

        <!-- 内存占用条 -->
        <ProgressBar Grid.Row="3" Height="6" Margin="0,7,0,0"
                     Minimum="0" Maximum="100"
                     x:Name="Bar_Mem" Value="0"/>
    </Grid>
</UserControl>
