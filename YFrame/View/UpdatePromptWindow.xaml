<Window x:Class="YFrame.View.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="11"
                        Background="{DynamicResource AccentGradientBrush}">
                    <TextBlock Text="↑" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="发现新版本" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="YFrame 工具集" FontSize="10.5"
                               Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CurrentVersionText" FontSize="11"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                    <TextBlock Text="  →  " FontSize="11"
                               Foreground="{DynamicResource SubtleTextBrush}"/>
                    <TextBlock x:Name="NewVersionText" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4"
                       Text="检测到可用的增量更新。更新程序将关闭当前窗口并完成升级，是否立即更新？"
                       FontSize="12" LineHeight="21"
                       Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="不更新" Click="LaterButton_Click" Margin="0,0,8,0"/>
                <Button Content="立即更新" Style="{StaticResource PrimaryButton}"
                        Click="UpdateButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
