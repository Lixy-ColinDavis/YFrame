<Window x:Class="YFrame.View.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 YFrame" Height="400" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource MenuBarBrush}"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="关于" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="32" Height="32"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}"
                            BorderThickness="0" FontSize="14" Click="CloseButton_Click"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Image Source="/View/Logo.png" Width="64" Height="64"
                       HorizontalAlignment="Center" Margin="0,10,0,15"/>

                <!-- 名称 -->
                <TextBlock Text="YFrame" HorizontalAlignment="Center"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>

                <!-- 版本 -->
                <TextBlock x:Name="VersionText" HorizontalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource TreeItemSecondaryText}"
                           Margin="0,0,0,4"/>

                <!-- 生成日期 -->
                <TextBlock x:Name="BuildDateText" HorizontalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TreeItemSecondaryText}"
                           Margin="0,0,0,14"/>

                <!-- 分隔线 -->
                <Rectangle Height="1" Width="280" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                <!-- 版权信息 -->
                <TextBlock Text="Copyright © 2025 Colin Davis" HorizontalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>

                <!-- 作者 -->
                <TextBlock HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TreeItemSecondaryText}" Margin="0,0,0,10">
                    <Run Text="Author："/><Run Text="Colin Davis" Foreground="{DynamicResource TextBrush}"/>
                </TextBlock>

                <!-- 邮箱 -->
                <TextBlock HorizontalAlignment="Center" FontSize="12" Cursor="Hand"
                           Foreground="{DynamicResource TextBrush}"
                           TextDecorations="Underline" Margin="0,0,0,20">
                    <Hyperlink Foreground="{DynamicResource TextBrush}" NavigateUri="mailto:lxycolin@hotmail.com"
                               RequestNavigate="EmailLink_RequestNavigate" IsEnabled="False">
                        lxycolin@hotmail.com
                    </Hyperlink>
                </TextBlock>

                <!-- 确定按钮 -->
                <Button Content="确定" Width="100" Height="30" Click="CloseButton_Click"
                        HorizontalAlignment="Center" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource MenuBarBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
