<Application x:Class="YFrame.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YFrame">
    <Application.Resources>

        <ResourceDictionary>

            <!-- 菜单下拉阴影 -->
            <DropShadowEffect x:Key="MenuShadow" BlurRadius="28" ShadowDepth="8"
                              Opacity="0.4" Color="#FF000000"/>

            <!-- ============================================================ -->
            <!-- 菜单栏：34px 高，圆角悬停，下拉为卡片式浮层                    -->
            <!-- ============================================================ -->
            <Style TargetType="{x:Type Menu}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <!-- 可勾选菜单项的勾选标记（如侧边栏显示/隐藏） -->
                                    <Path x:Name="CheckMark" Data="M2,6 L5,9 L11,2"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="12" Height="12" Margin="0,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                    <ContentPresenter x:Name="HeaderHost"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <Popup x:Name="Popup"
                                           Placement="Bottom"
                                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Fade"
                                           VerticalOffset="4">
                                        <Border x:Name="SubMenuBorder"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="5"
                                                MinWidth="184"
                                                Effect="{StaticResource MenuShadow}">
                                            <ScrollViewer x:Name="SubMenuScrollViewer"
                                                          Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                                <ItemsPresenter x:Name="ItemsPresenter"
                                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 悬停 / 键盘高亮：强调色浅底 + 强调色文字 -->
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Border" Property="Background"
                                            Value="{DynamicResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <!-- 子菜单展开时保持高亮 -->
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="Border" Property="Background"
                                            Value="{DynamicResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <!-- 可勾选项：显示勾选标记并给文字留出缩进 -->
                                <Trigger Property="IsCheckable" Value="True">
                                    <Setter TargetName="HeaderHost" Property="Margin" Value="18,0,0,0"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 菜单分隔线 -->
            <Style TargetType="{x:Type Separator}">
                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Border Background="{TemplateBinding Background}"
                                    Height="1" Margin="{TemplateBinding Margin}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================ -->
            <!-- 左侧插件列表（设计稿侧边栏样式：圆角行 + 渐变字母图标）        -->
            <!-- ============================================================ -->
            <Style x:Key="VsPluginListBox" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>

            <Style x:Key="VsPluginListItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="9"
                                    Margin="8,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 渐变色字母图标 -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                            Background="{Binding IconBrush}" VerticalAlignment="Center">
                                        <Grid>
                                            <!-- 终端主题下叠加绿色，统一图标色调 -->
                                            <Border Background="{DynamicResource PluginIconTintBrush}"
                                                    CornerRadius="8"/>
                                            <TextBlock Text="{Binding IconText}"
                                                       Foreground="White" FontSize="10.5"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- 名称 + 插件 ID -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="NameText" Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ID}"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource TreeItemHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource TreeItemSelectedBackground}"/>
                                    <Setter TargetName="NameText" Property="Foreground"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 工具箱工具列表项（渐变图标块 + 内容模板） -->
            <Style x:Key="VsToolboxListItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="9"
                                    Margin="8,1" Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{DynamicResource AccentGradientBrush}"
                                            VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="White" Opacity="0.95"
                                                      Data="M22.7,19l-9.1-9.1c0.9-2.3,0.4-5-1.5-6.9c-2-2-5-2.4-7.4-1.3L9,6L6,9L1.6,4.7C0.4,7.1,0.9,10.1,2.9,12.1c1.9,1.9,4.6,2.4,6.9,1.5l9.1,9.1c0.4,0.4,1,0.4,1.4,0l2.3-2.3C23.1,20,23.1,19.4,22.7,19z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource TreeItemHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource TreeItemSelectedBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================ -->
            <!-- 全局滚动条：8px，圆角滑块，悬停加深                            -->
            <!-- ============================================================ -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Root" Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Style="{x:Null}" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Style="{x:Null}" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Opacity="0.4" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{DynamicResource SubtleTextBrush}"
                                                            CornerRadius="4"
                                                            Margin="2,2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Thumb" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 工具提示：与卡片风格一致 -->
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <!-- 默认加载云白简约主题 -->
                <ResourceDictionary Source="Common/Themes/CloudWhiteTheme.xaml"/>
                <ResourceDictionary Source="Common/Themes/ControlStyles.xaml"/>
                <ResourceDictionary Source="Common/Language/zh-CN.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
