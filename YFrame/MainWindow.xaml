<Window x:Class="YFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YF Tools" Height="800" Width="1200"
        Icon="Common/Images/Logo.png"
        xmlns:local="clr-namespace:YFrame"
        Background="{DynamicResource BackgroundBrush}" 
        WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <!-- Boolean 到 Visibility 的转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MenuBarBrush}" Foreground="{DynamicResource TextBrush}" Height="34">
            <!-- Logo -->
            <Image Source="Common/Images/Logo.png" Width="20" Height="20" Margin="3,0,5,0" VerticalAlignment="Center"/>
            <MenuItem Header="{DynamicResource key_File}" Background="{DynamicResource MenuBarBrush}" Foreground="{DynamicResource TextBrush}">
                <MenuItem Header="{DynamicResource key_New}" Command="{Binding NewScriptCommand}"/>
                <MenuItem Header="{DynamicResource key_Open}" Command="{Binding OpenScriptCommand}"/>
                <MenuItem Header="{DynamicResource key_Save}" Command="{Binding SaveScriptCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource key_Exit}" Command="{Binding Btn_Exit_Command}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource key_Edit}"/>
            <MenuItem Header="{DynamicResource key_View}" Foreground="{DynamicResource TextBrush}" >
                <MenuItem Header="{DynamicResource key_Left sidebar}" IsCheckable="True" IsChecked="True" Command="{Binding ToggleLeftToolWindowCommand}"/>
                <MenuItem Header="{DynamicResource key_Right sidebar}" IsCheckable="True" IsChecked="True" Command="{Binding ToggleRightToolWindowCommand}"/>
                <MenuItem Header="{DynamicResource key_DarkGray theme}" Command="{Binding SetThemeCommand}" CommandParameter="Common/Themes/DarkGrayTheme.xaml"/>
                <MenuItem Header="{DynamicResource key_CreamWhite theme}" Command="{Binding SetThemeCommand}" CommandParameter="Common/Themes/CreamWhiteTheme.xaml"/>
                <MenuItem Header="{DynamicResource key_LightBlue theme}" Command="{Binding SetThemeCommand}" CommandParameter="Common/Themes/LightBlueTheme.xaml"/>
                <MenuItem Header="{DynamicResource key_GreenWhite theme}" Command="{Binding SetThemeCommand}" CommandParameter="Common/Themes/GreenWhiteTheme.xaml"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource key_Language}">
                <MenuItem Header="中文"  Command="{Binding ToggleChineseCommand}"/>
                <MenuItem Header="English"  Command="{Binding ToggleEnglishCommand}"/>
            </MenuItem>
        <MenuItem Header="{DynamicResource key_Plug-in}">
                <MenuItem Header="{DynamicResource key_LoadPlugin}"/>
                <MenuItem Header="{DynamicResource key_PluginManager}" Command="{Binding PluginManagerCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource key_Help}">
                <MenuItem Header="{DynamicResource key_About}" Command="{Binding Btn_About_Command}"/>
            </MenuItem>
            <MenuItem IsEnabled="False"/>
            <!-- 右侧可拖拽区域 -->
            <Border Name="Title_Border" DockPanel.Dock="Right" Background="{DynamicResource MenuBarBrush}" BorderBrush="{DynamicResource MenuBarBrush}"  Width="750" Margin="-20,-6,-20,-11">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Title_Move_Command}" CommandParameter="{Binding ElementName=Title_Border}"/>
                </Border.InputBindings>
                
            </Border>
            <MenuItem IsEnabled="False"/>
            <MenuItem Name="Min" Header="─" Command="{Binding Btn_Minimize_Command}"/>
            <MenuItem Name="Close" Header="✕" Command="{Binding Btn_Exit_Command}"/>


        </Menu>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBg}" Height="28"
                   FontFamily="Consolas" FontSize="11"
                   Foreground="{DynamicResource TreeItemSecondaryText}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#FF34D399" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource key_Running}" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="{DynamicResource TextBrush}">
                    <Run Text="{DynamicResource key_CpuLabel}"/><Run Text="{Binding Txt_Cpu, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="{DynamicResource TextBrush}">
                    <Run Text="{DynamicResource key_MemoryLabel}"/><Run Text="{Binding Txt_Memory, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{DynamicResource key_PluginLabel}"/><Run Text="{Binding lsPlugins.Count, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/><Run Text="{DynamicResource key_LoadedPlugins}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="{DynamicResource TextBrush}">
                    <Run Text="{DynamicResource key_HotkeyStatusLabel}"/><Run Text="{Binding HotkeyStatusText, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- 主内容区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- 工具栏区域：热键监控开关 + 打开日志文件夹 -->
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"  Background="{DynamicResource ToolWindowBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 0 1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <!-- 热键监控开关（绿点/灰点 + 按钮样式） -->
                    <Button Command="{Binding ToggleHotkeyCommand}"
                            Height="26" Margin="0,0,10,0"
                            Background="{DynamicResource MenuBarBrush}" 
                            Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Cursor="Hand" ToolTip="{DynamicResource key_HotkeyTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF9E9E9E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHotkeyEnabled}" Value="True">
                                                <Setter Property="Fill" Value="#FF34D399"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{DynamicResource key_HotkeyMonitor}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 打开日志文件夹按钮 -->
                    <Button Content="{DynamicResource key_OpenLogFolder}" Command="{Binding OpenLogFolderCommand}"
                            Width="100" Height="26"
                            Background="{DynamicResource MenuBarBrush}" 
                            Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Cursor="Hand">
                    </Button>
                </StackPanel>
            </Border>

            <!-- 左侧工具栏抽屉（VS 风格：竖排标签 + 内容面板） -->
            <Border Grid.Column="0" Grid.RowSpan="2"
                    Background="{DynamicResource MenuBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 1 0"
                    Visibility="{Binding LeftVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- 竖排标签栏 -->
                    <Border Grid.Column="0" Background="{DynamicResource MenuBarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 1 0">
                        <StackPanel>
                            <!-- 插件列表 标签 -->
                            <Border x:Name="TabPlugins" Height="80" Cursor="Hand"
                                    Background="{DynamicResource MenuBarBrush}"
                                    ToolTip="{DynamicResource key_PluginList}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding SwitchLeftPanelCommand}"
                                                  CommandParameter="0"/>
                                </Border.InputBindings>
                                <TextBlock Text="{DynamicResource key_PluginList}"
                                           FontSize="11" TextAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Border>
                            <!-- 分隔线 -->
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}"
                                       Margin="4,0"/>
                            <!-- 工具箱 标签 -->
                            <Border x:Name="TabToolbox" Height="70" Cursor="Hand"
                                    Background="{DynamicResource MenuBarBrush}"
                                    ToolTip="{DynamicResource key_Toolbox}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding SwitchLeftPanelCommand}"
                                                  CommandParameter="1"/>
                                </Border.InputBindings>
                                <TextBlock Text="{DynamicResource key_Toolbox}"
                                           FontSize="11" TextAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 内容面板 -->
                    <Border Grid.Column="1" Background="{DynamicResource MenuBarBrush}">
                        <DockPanel>
                            <!-- 面板标题栏 -->
                            <Border DockPanel.Dock="Top" Height="28"
                                    Background="{DynamicResource MenuBarBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 0 1">
                                <Grid>
                                    <TextBlock Text="{DynamicResource key_PluginList}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource key_Toolbox}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <!-- 面板内容：插件列表 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="1">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ListBox Style="{StaticResource VsPluginListBox}"
                                         ItemContainerStyle="{StaticResource VsPluginListItem}"
                                         ItemsSource="{Binding lsPlugins}"
                                         SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                                         Margin="0,2,0,0"/>
                            </Grid>
                            <!-- 面板内容：工具箱（预留） -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="{DynamicResource key_ToolboxContent}"
                                           Foreground="{DynamicResource TreeItemSecondaryText}"
                                           FontSize="12" VerticalAlignment="Top"
                                           Margin="14,14,0,0"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 主工作区 -->
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="3" Background="{DynamicResource BorderBrush}" 
                 HorizontalAlignment="Left" VerticalAlignment="Stretch"/>

            <Grid x:Name="DynamicContentHost" Grid.Row="1"  Grid.Column="1" Margin="5" Background="{DynamicResource BackgroundBrush}">
                <ContentControl Content="{Binding Grid_Show_Array}" Margin="5"/>
            </Grid>

            <GridSplitter Grid.Column="1" Grid.Row="1" Width="3" Background="{DynamicResource BorderBrush}" 
                 HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

            <!-- 右侧工具栏抽屉 -->
            <Border Grid.Column="2" Width="250" Grid.Row="1"
                    Background="{DynamicResource MenuBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1 0 0 0"
                    Visibility="{Binding RightVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 上部面板（VS 风格：内容 + 竖排标签） -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <!-- 内容面板 -->
                        <DockPanel Grid.Column="0">
                            <!-- 标题栏 -->
                            <Border DockPanel.Dock="Top" Height="28"
                                    Background="{DynamicResource MenuBarBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 0 1">
                                <Grid>
                                    <TextBlock Text="{DynamicResource key_Log}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveRightPanel}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource key_Param}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveRightPanel}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- 日志与参数面板重叠在同一区域，通过 ActiveRightPanel 切换显示 -->
                            <Grid>
                                <!-- 日志面板 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveRightPanel}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveRightPanel}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBox TextWrapping="Wrap" AcceptsReturn="True"
                                             IsReadOnly="True" Focusable="False"
                                             Text="{Binding LogText}" VerticalScrollBarVisibility="Auto"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                             BorderThickness="0"/>
                                    <Button Content="{DynamicResource key_ClearLog}" Command="{Binding ClearLogCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Height="24" FontSize="11" Padding="8,2" Margin="0,0,4,4"
                                            Background="{DynamicResource MenuBarBrush}"
                                            Foreground="{DynamicResource TextBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Cursor="Hand"/>
                                </Grid>

                                <!-- 参数面板 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveRightPanel}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActiveRightPanel}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ParametersItemsControl" ItemsSource="{Binding Parameters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                                   VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="5,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button Content="{DynamicResource key_AddParam}"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Height="24" FontSize="11" Padding="8,2" Margin="4,0,0,4"
                                            Background="{DynamicResource MenuBarBrush}"
                                            Foreground="{DynamicResource TextBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Cursor="Hand"/>
                                    <Button Content="{DynamicResource key_DeleteParam}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Height="24" FontSize="11" Padding="8,2" Margin="0,0,4,4"
                                            Background="{DynamicResource MenuBarBrush}"
                                            Foreground="{DynamicResource TextBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Cursor="Hand"/>
                                </Grid>
                            </Grid>
                        </DockPanel>

                            <!-- 竖排标签栏（右边缘） -->
                            <Border Grid.Column="1" Background="{DynamicResource MenuBarBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1 0 0 0">
                                <StackPanel>
                                    <!-- 日志 标签 -->
                                    <Border Height="60" Cursor="Hand"
                                            Background="{DynamicResource MenuBarBrush}" ToolTip="{DynamicResource key_Log}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding SwitchRightPanelCommand}"
                                                          CommandParameter="0"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{DynamicResource key_Log}" FontSize="11"
                                                   TextAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90"/>
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                                    <!-- 参数 标签 -->
                                    <Border Height="60" Cursor="Hand"
                                            Background="{DynamicResource MenuBarBrush}" ToolTip="{DynamicResource key_Param}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding SwitchRightPanelCommand}"
                                                          CommandParameter="1"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{DynamicResource key_Param}" FontSize="11"
                                                   TextAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90"/>
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                    <GridSplitter Grid.Row="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>

                    <!-- 下部抽屉 - 性能监视器 -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" Margin="0,0,2,0">
                        <DockPanel  >
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource MenuBarBrush}">
                                <TextBlock Text="{DynamicResource key_Performance monitor}" Margin="5" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <!--<local:PerformanceMonitor/>-->
                            <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="0.5"
                                    Margin="4" Background="{DynamicResource BackgroundBrush}">
                                <ContentControl Content="{Binding Performance_Monitor_View}" Margin="4"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>

