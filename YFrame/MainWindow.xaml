<Window x:Class="YFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YF Tools" Height="800" Width="1200"
        xmlns:local="clr-namespace:YFrame"
        Background="{DynamicResource BackgroundBrush}" 
        WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <!-- Boolean 到 Visibility 的转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MenuBarBrush}" Foreground="{DynamicResource TextBrush}" Height="34">
            <MenuItem Header="{DynamicResource key_File}" Background="{DynamicResource MenuBarBrush}" Foreground="{DynamicResource TextBrush}">
                <MenuItem Header="{DynamicResource key_New}"/>
                <MenuItem Header="{DynamicResource key_Open}"/>
                <MenuItem Header="{DynamicResource key_Exit}" Command="{Binding Btn_Exit_Command}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource key_Edit}"/>
            <MenuItem Header="{DynamicResource key_View}" Foreground="{DynamicResource TextBrush}" >
                <MenuItem Header="{DynamicResource key_Left sidebar}" IsCheckable="True" IsChecked="True" Command="{Binding ToggleLeftToolWindowCommand}"/>
                <MenuItem Header="{DynamicResource key_Right sidebar}" IsCheckable="True" IsChecked="True" Command="{Binding ToggleRightToolWindowCommand}"/>
                <MenuItem Header="{DynamicResource key_Bright theme}" Command="{Binding ToggleLightThemeCommand}" CommandParameter="Light"/>
                <MenuItem Header="{DynamicResource key_Dark theme}" Command="{Binding ToggleDarkThemeCommand}" CommandParameter="Dark"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource key_Language}">
                <MenuItem Header="中文"  Command="{Binding ToggleChineseCommand}"/>
                <MenuItem Header="English"  Command="{Binding ToggleEnglishCommand}"/>
            </MenuItem>
        <MenuItem Header="{DynamicResource key_Plug-in}">
                <MenuItem Header="加载插件"/>
                <MenuItem Header="插件管理器"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource key_Help}"/>
            <MenuItem IsEnabled="False"/>
            <!-- 右侧可拖拽区域 -->
            <Border Name="Title_Border" DockPanel.Dock="Right" Background="{DynamicResource MenuBarBrush}" BorderBrush="{DynamicResource MenuBarBrush}"  Width="806" Margin="-20,-6,-20,-11">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Title_Move_Command}" CommandParameter="{Binding ElementName=Title_Border}"/>
                </Border.InputBindings>
                
            </Border>
            <MenuItem IsEnabled="False"/>
            <MenuItem Name="Min" Header="─" Command="{Binding Btn_Minimize_Command}"/>
            <MenuItem Name="Close" Header="✕" Command="{Binding Btn_Exit_Command}"/>


        </Menu>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource MenuBarBrush}" Height="25">
            <StatusBarItem>
                <TextBlock Text="就绪" Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Txt_Cpu}" Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Txt_Memory}" Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 主内容区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧工具栏抽屉 -->
            <Border Grid.Column="0" Width="200" Background="{DynamicResource ToolWindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 1 0" Visibility="{Binding LeftVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <TabControl Background="{DynamicResource ToolWindowBrush}">
                        <TabItem Header="{DynamicResource key_Plug-in}" >
                            <ItemsControl Grid.Row="3" Margin="0,0,0,20"  Background="{DynamicResource BackgroundBrush}" ItemsSource="{Binding lsPlugins}">
                                <!-- 绑定到你的数据源 -->
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="5" Height="33" Width="180" Margin="5,5,5,0" Background="{DynamicResource ToolWindowBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="5"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0" Grid.Column="0" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                    <!--<MenuItem Header="{DynamicResource key_Stay}" BorderThickness="0" BorderBrush="{DynamicResource ToolWindowBrush}" Grid.Column="1" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ToolWindowBrush}"/>-->
                                                    <Button Content="{DynamicResource key_Show}" BorderThickness="0" Background="{DynamicResource ToolWindowBrush}" 
                                                            Foreground="{DynamicResource TextBrush}" Width="40" Margin="0,0,5,0" Grid.Column="1" HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.Btn_Plugin_Show_Command, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                            CommandParameter="{Binding ID}">
                                                        <!-- 在ItemsControl中，command会寻找上下文对象PluginsModel的Btn_Plugin_Show_Command，
                                                             而不是viewModel.DataContext中的Btn_Plugin_Show_Command，
                                                             由于默认源是ViewModel.DataContext,默认源发生修改后，手动改回去需要标注DataContext.Btn_Plugin_Show_Command，
                                                             否则寻找位置是ViewModel.Btn_Plugin_Show_Command
                                                        -->
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </TabItem>
                        <TabItem Header="{DynamicResource key_Stay}" >
                            <ItemsControl Grid.Row="3" Margin="0,0,0,20"  Background="{DynamicResource BackgroundBrush}" ItemsSource="{Binding lsPlugins_Stay}">
                                <!-- 绑定到数据源 -->
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="5" Height="33" Width="180" Margin="5,5,5,0" Background="{DynamicResource ToolWindowBrush}">
                                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <!-- 主工作区 -->
            <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderBrush}" 
                 HorizontalAlignment="Left" VerticalAlignment="Stretch"/>

            <!--<ContentControl Grid.Column="1" Content="{Binding CurrentPluginContent}"
                   Background="{DynamicResource BackgroundBrush}"/>-->
            <Grid x:Name="DynamicContentHost" Grid.Column="1" Margin="5" Background="{DynamicResource BackgroundBrush}">
                <ContentControl Content="{Binding Grid_Show_Array}" Margin="5"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderBrush}" 
                 HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

            <!-- 右侧工具栏抽屉 -->
            <Border Grid.Column="2" Width="250" Background="{DynamicResource ToolWindowBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1 0 0 0"
                    Visibility="{Binding RightVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 上部抽屉 -->
                    <DockPanel Grid.Row="0">
                        <!--<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource MenuBarBrush}">
                            <ToggleButton Content="日志" IsChecked="{Binding IsLogViewVisible}"/>
                            <ToggleButton Content="参数" IsChecked="{Binding IsParameterViewVisible}"/>
                        </StackPanel>-->

                        <TabControl Background="{DynamicResource BackgroundBrush}">
                            <TabItem Header="{DynamicResource key_Log}" >
                                <TextBox TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                Text="{Binding LogText}" VerticalScrollBarVisibility="Auto"
                                Background="Transparent" Foreground="{DynamicResource TextBrush}"/>
                            </TabItem>
                            <TabItem Header="{DynamicResource key_Param}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ParametersItemsControl" ItemsSource="{Binding Parameters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" 
                                      Text="{Binding Key}" 
                                      VerticalAlignment="Center"
                                      Margin="5,0"/>
                                                        <TextBox Grid.Column="1" 
                                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="5,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                                        <Button Content="添加参数" Margin="5,0"/>
                                        <Button Content="删除参数" Margin="5,0"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch"/>

                    <!-- 下部抽屉 - 性能监视器 -->
                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource MenuBarBrush}">
                            <TextBlock Text="{DynamicResource key_Performance monitor}" Margin="5" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <!--<local:PerformanceMonitor/>-->
                        <ContentControl Content="{Binding Performance_Monitor_View}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>

