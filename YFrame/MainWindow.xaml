<Window x:Class="YFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YFrame"
        Title="YF Tools" Height="800" Width="1240"
        Icon="Common/Images/Logo.png"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        FontFamily="{DynamicResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Boolean 到 Visibility 的转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 标题栏右侧窗口按钮（最小化 / 全屏 / 关闭） -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{DynamicResource PanelHoverBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：悬停转为危险色 -->
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日志面板输入框样式：内容从顶部开始，等宽字体 -->
        <Style x:Key="LogTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- 日志内容垂直拉伸到顶部，随内容向下滚动 -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧竖排标签：选中时显示强调色浅底与指示条 -->
        <Style x:Key="RailTab" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <!-- 圆角窗口外壳 + 阴影 + 氛围光 -->
    <Border x:Name="WindowFrame"
            CornerRadius="14"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            Effect="{DynamicResource WindowShadow}">
        <Grid>
            <!-- 背景氛围光（不参与命中测试） -->
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-190,-190,0,0" Fill="{DynamicResource GlowBrush1}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="90"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-170,-170" Fill="{DynamicResource GlowBrush2}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="90"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <DockPanel LastChildFill="True">
                <!-- ================= 标题栏 ================= -->
                <Border DockPanel.Dock="Top" Height="46"
                        Background="{DynamicResource TitleBarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- 应用标识 + 名称 + 版本 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="16,0,0,0" IsHitTestVisible="False">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <TextBlock Text="YF" Foreground="White" FontSize="10.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="YF Tools" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding AppVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="10.5"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- 拖拽区域（避开右侧按钮） -->
                        <Border Name="Title_Border" Background="Transparent" Margin="0,0,132,0">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding Title_Move_Command}"
                                              CommandParameter="{Binding ElementName=Title_Border}"/>
                            </Border.InputBindings>
                        </Border>

                        <!-- 窗口控制按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource TitleBarButton}" Content="─"
                                    Command="{Binding Btn_Minimize_Command}"
                                    ToolTip="{DynamicResource key_Minimize}"/>
                            <Button Style="{StaticResource TitleBarButton}"
                                    Command="{Binding ToggleFullScreenCommand}"
                                    ToolTip="{DynamicResource key_FullScreenTooltip}">
                                <TextBlock FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▢"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                                    <Setter Property="Text" Value="❐"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseButton}" Content="✕"
                                    Command="{Binding Btn_Exit_Command}"
                                    ToolTip="{DynamicResource key_Close}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 菜单栏 ================= -->
                <Border DockPanel.Dock="Top" Height="34"
                        Background="{DynamicResource MenuBarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Menu DockPanel.Dock="Left" Background="Transparent"
                          Foreground="{DynamicResource TextBrush}"
                          VerticalAlignment="Center" Margin="8,0,0,0">
                        <MenuItem Header="{DynamicResource key_File}">
                            <MenuItem Header="{DynamicResource key_New}" Command="{Binding NewScriptCommand}"/>
                            <MenuItem Header="{DynamicResource key_Open}" Command="{Binding OpenScriptCommand}"/>
                            <MenuItem Header="{DynamicResource key_Save}" Command="{Binding SaveScriptCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource key_Exit}" Command="{Binding Btn_Exit_Command}"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource key_Edit}"/>
                        <MenuItem Header="{DynamicResource key_View}">
                            <MenuItem Header="{DynamicResource key_Left sidebar}" IsCheckable="True" IsChecked="True"
                                      Command="{Binding ToggleLeftToolWindowCommand}"/>
                            <MenuItem Header="{DynamicResource key_Right sidebar}" IsCheckable="True" IsChecked="True"
                                      Command="{Binding ToggleRightToolWindowCommand}"/>
                            <MenuItem Header="{DynamicResource key_FullScreen}" Command="{Binding ToggleFullScreenCommand}"/>
                            <MenuItem Header="{DynamicResource key_NightTech theme}" Command="{Binding SetThemeCommand}"
                                      CommandParameter="Common/Themes/NightTechTheme.xaml"/>
                            <MenuItem Header="{DynamicResource key_CloudWhite theme}" Command="{Binding SetThemeCommand}"
                                      CommandParameter="Common/Themes/CloudWhiteTheme.xaml"/>
                            <MenuItem Header="{DynamicResource key_RetroTerminal theme}" Command="{Binding SetThemeCommand}"
                                      CommandParameter="Common/Themes/RetroTerminalTheme.xaml"/>
                            <MenuItem Header="{DynamicResource key_Glass theme}" Command="{Binding SetThemeCommand}"
                                      CommandParameter="Common/Themes/GlassTheme.xaml"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource key_Language}">
                            <MenuItem Header="中文" Command="{Binding ToggleChineseCommand}"/>
                            <MenuItem Header="English" Command="{Binding ToggleEnglishCommand}"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource key_Plug-in}">
                            <MenuItem Header="{DynamicResource key_LoadPlugin}" Command="{Binding ReloadPluginsCommand}"/>
                            <MenuItem Header="{DynamicResource key_PluginManager}" Command="{Binding PluginManagerCommand}"/>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource key_Help}">
                            <MenuItem Header="{DynamicResource key_About}" Command="{Binding Btn_About_Command}"/>
                        </MenuItem>
                    </Menu>
                </Border>

                <!-- ================= 状态栏 ================= -->
                <Border DockPanel.Dock="Bottom" Height="30"
                        Background="{DynamicResource StatusBarBg}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                                             Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource key_Running}" FontSize="11.5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource key_CpuLabel}" FontSize="11.5"
                                               Foreground="{DynamicResource SubtleTextBrush}"/>
                                    <TextBlock Text="{Binding Txt_Cpu, Mode=OneWay}"
                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                                               Foreground="{DynamicResource TextBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource key_MemoryLabel}" FontSize="11.5"
                                               Foreground="{DynamicResource SubtleTextBrush}"/>
                                    <TextBlock Text="{Binding Txt_Memory, Mode=OneWay}"
                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                                               Foreground="{DynamicResource TextBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource key_PluginLabel}" FontSize="11.5"
                                               Foreground="{DynamicResource SubtleTextBrush}"/>
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                                               Foreground="{DynamicResource TextBrush}" Margin="6,0,0,0">
                                        <Run Text="{Binding lsPlugins.Count, Mode=OneWay}"/>
                                        <Run Text="{DynamicResource key_LoadedPlugins}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource key_HotkeyStatusLabel}" FontSize="11.5"
                                               Foreground="{DynamicResource SubtleTextBrush}"/>
                                    <TextBlock Text="{Binding HotkeyStatusText, Mode=OneWay}" FontSize="11.5"
                                               Foreground="{DynamicResource TextBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="YF Tools" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,14,0" FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}"/>
                    </Grid>
                </Border>

                <!-- ================= 主内容 ================= -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部工具条：热键监控 / 日志目录 / 屏幕缩放 -->
                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleHotkeyCommand}"
                                        Padding="12,5" ToolTip="{DynamicResource key_HotkeyTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SubtleTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHotkeyEnabled}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{DynamicResource key_HotkeyMonitor}" FontSize="12"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Content="{DynamicResource key_OpenLogFolder}"
                                        Command="{Binding OpenLogFolderCommand}"
                                        Margin="8,0,0,0" Padding="12,5"/>

                                <TextBlock Text="{DynamicResource key_ScreenScaleLabel}" FontSize="11.5"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           VerticalAlignment="Center" Margin="18,0,8,0"/>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding ScreenScaleOptions}"
                                          Text="{Binding ScreenScaleText, UpdateSourceTrigger=LostFocus}"
                                          Width="76" Height="30" FontSize="12"
                                          VerticalAlignment="Center"
                                          ToolTip="{DynamicResource key_ScreenScaleTooltip}"/>
                                <TextBlock Text="%" FontSize="11.5"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 左侧抽屉：竖排标签 + 插件/工具箱列表 -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Width="236"
                            Background="{DynamicResource MenuBarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0"
                            Visibility="{Binding LeftVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 竖排标签栏 -->
                            <Border Grid.Column="0" Background="Transparent"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <StackPanel>
                                    <Border x:Name="TabPlugins" Height="78"
                                            ToolTip="{DynamicResource key_PluginList}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding SwitchLeftPanelCommand}"
                                                          CommandParameter="0"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource RailTab}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AccentSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{DynamicResource key_PluginList}"
                                                   Width="72" Height="16"
                                                   FontSize="10.5" TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90"/>
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="5,0"/>
                                    <Border x:Name="TabToolbox" Height="70"
                                            ToolTip="{DynamicResource key_Toolbox}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding SwitchLeftPanelCommand}"
                                                          CommandParameter="1"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource RailTab}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="1">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AccentSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{DynamicResource key_Toolbox}"
                                                   Width="72" Height="16"
                                                   FontSize="10.5" TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90"/>
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 内容面板 -->
                            <DockPanel Grid.Column="1">
                                <!-- 面板标题：标题 + 数量徽标 -->
                                <Border DockPanel.Dock="Top" Height="42"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,0">
                                    <Grid>
                                        <TextBlock Text="{DynamicResource key_PluginList}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource key_Toolbox}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource MonoText}" FontSize="10">
                                                <Run Text="{Binding lsPlugins.Count, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 底部统计 -->
                                <Border DockPanel.Dock="Bottom" Height="32"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource key_PluginLabel}"
                                                   Style="{StaticResource MonoText}" FontSize="10"/>
                                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="10" Foreground="{DynamicResource SubtleTextBrush}"
                                                   Margin="4,0,0,0">
                                            <Run Text="{Binding lsPlugins.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 列表区域：插件列表与工具箱共用一个填充容器 -->
                                <Grid>
                                    <!-- 插件列表 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="1">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <ListBox Style="{StaticResource VsPluginListBox}"
                                                 ItemContainerStyle="{StaticResource VsPluginListItem}"
                                                 ItemsSource="{Binding lsPlugins}"
                                                 SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                                                 Margin="0,6,0,6"/>
                                    </Grid>

                                    <!-- 工具箱列表 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActiveLeftPanel}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <ListBox Style="{StaticResource VsPluginListBox}"
                                                 ItemContainerStyle="{StaticResource VsToolboxListItem}"
                                                 ItemsSource="{Binding Tools}"
                                                 SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                                                 Margin="0,6,0,6">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="12"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10"
                                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 左侧分隔条 -->
                    <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="1"
                                  Background="{DynamicResource BorderBrush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- 主工作区 -->
                    <Grid x:Name="DynamicContentHost" Grid.Row="1" Grid.Column="1"
                          Background="{DynamicResource BackgroundBrush}">
                        <ContentControl Content="{Binding Grid_Show_Array}" Margin="14,4,14,14">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToolActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <ContentControl Content="{Binding ActiveToolView}" Margin="14,4,14,14">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToolActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToolActive}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <!-- 空状态：未选择插件且未打开工具时显示，避免主工作区空白 -->
                        <Grid IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedPlugin}" Value="{x:Null}"/>
                                                <Condition Binding="{Binding IsToolActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="18"
                                        Background="{DynamicResource AccentGradientBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="YF" Foreground="White" FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource key_WelcomeTitle}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                <TextBlock Text="{DynamicResource key_WelcomeHint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <Border Style="{StaticResource BadgeBorder}"
                                        HorizontalAlignment="Center" Margin="0,20,0,0"
                                        Padding="12,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ctrl+Y" FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{DynamicResource key_HotkeyMonitor}"
                                                   FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 右侧抽屉：日志 + 性能监视器 -->
                    <Border Grid.Column="2" Width="300" Grid.Row="1"
                            Background="{DynamicResource MenuBarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                            Visibility="{Binding RightVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.6*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 日志卡片 -->
                            <Border Grid.Row="0" Style="{StaticResource CardBorder}"
                                    Margin="12,10,12,0" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="42"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="14,0">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource key_Log}"
                                                       Style="{StaticResource SectionTitle}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}"
                                                        Command="{Binding ClearLogCommand}"
                                                        ToolTip="{DynamicResource key_ClearLog}">
                                                    <Path Data="M4,6.5 H16 M9.5,6.5 V4.8 A1.6,1.6 0 0 1 11.1,3.2 H12.9 A1.6,1.6 0 0 1 14.5,4.8 V6.5 M6.5,6.5 L7.4,19 A1.8,1.8 0 0 0 9.2,20.7 H14.8 A1.8,1.8 0 0 0 16.6,19 L17.5,6.5"
                                                          Stroke="{DynamicResource SubtleTextBrush}"
                                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" Width="16" Height="16"
                                                          Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBox Style="{StaticResource LogTextBox}"
                                             Text="{Binding LogText}"
                                             IsReadOnly="True" Focusable="False"/>
                                </DockPanel>
                            </Border>

                            <!-- 日志 / 性能之间留白 -->
                            <Border Grid.Row="1"/>

                            <!-- 性能监视器卡片 -->
                            <Border Grid.Row="2" Style="{StaticResource CardBorder}"
                                    Margin="12,0,12,12" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="42"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="14,0">
                                        <TextBlock Text="{DynamicResource key_Performance monitor}"
                                                   Style="{StaticResource SectionTitle}"/>
                                    </Border>
                                    <ContentControl Content="{Binding Performance_Monitor_View}"
                                                    Margin="6"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
